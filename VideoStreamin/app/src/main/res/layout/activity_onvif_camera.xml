<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    tools:context=".MainActivity">

    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/activity_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/white">

        <FrameLayout
            android:id="@+id/fourViewFragment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="105dp"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:layout_marginTop="5dp"/>

        <!--android:layout_alignBottom="@id/fourViewFragment"
         android:layout_alignParentTop="@+id/navigationView" -->
        <co.ceryle.segmentedbutton.SegmentedButtonGroup
            android:id="@+id/segmentedButtonGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="360dp"
            android:layout_above="@id/navigationView"
            app:sbg_animateSelector="bounce"
            app:sbg_animateSelectorDuration="500"
            app:sbg_backgroundColor="@color/appColor"
            app:sbg_dividerColor="@color/black"
            app:sbg_dividerPadding="1dp"
            app:sbg_dividerRadius="12dp"
            app:sbg_dividerSize="2dp"
            app:sbg_position="1"
            app:sbg_radius="2dp"
            app:sbg_ripple="true"
            app:sbg_selectorColor="@color/black"
            app:sbg_selectorTextColor="@color/white"
            tools:ignore="NotSibling,UnknownId">

            <co.ceryle.segmentedbutton.SegmentedButton
                android:layout_width="wrap_content"
                android:layout_height="2dp"
                android:id="@+id/oneGrid"
                android:text="1"
                android:textSize="15dp"
                android:textStyle="bold"/>

            <co.ceryle.segmentedbutton.SegmentedButton
                android:layout_width="wrap_content"
                android:layout_height="2dp"
                android:id="@+id/fourGrid"
                android:text="2"
                android:textSize="15dp"
                android:textStyle="bold"/>
            <co.ceryle.segmentedbutton.SegmentedButton
                android:layout_width="wrap_content"
                android:layout_height="2dp"
                android:id="@+id/eightGrid"
                android:text="4"
                android:textSize="15dp"
                android:textStyle="bold"/>
            <co.ceryle.segmentedbutton.SegmentedButton
                android:layout_width="wrap_content"
                android:layout_height="2dp"
                android:id="@+id/nineGrid"
                android:text="9"
                android:textSize="15dp"
                android:textStyle="bold"/>
            <co.ceryle.segmentedbutton.SegmentedButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/sixteentGrid"
                android:text="16"
                android:textSize="15dp"
                android:textStyle="bold"/>
        </co.ceryle.segmentedbutton.SegmentedButtonGroup>
    </RelativeLayout>

    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentBottom="true"
        android:layout_above="@id/navigationView"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <android.support.design.widget.BottomNavigationView
        android:id="@+id/navigationView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="0dp"
        android:layout_marginStart="0dp"
        android:background="?android:attr/windowBackground"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:itemBackground="@color/colorBlackAniline"
        app:itemIconTint="@color/appColor"
        app:itemTextColor="@color/white"
        app:menu="@menu/navigation"/>
</android.support.constraint.ConstraintLayout>
