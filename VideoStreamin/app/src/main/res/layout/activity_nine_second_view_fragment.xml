<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TableLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="2dp"
        android:orientation="vertical"
        android:stretchColumns="*"
        tools:ignore="MissingConstraints">
        <TableRow
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="center">
            <SurfaceView
                android:id="@+id/surfaceviewSecondNineteen1"
                android:layout_gravity="fill"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="1dp"
                />
            <SurfaceView
                android:id="@+id/surfaceviewSecondNineteen2"
                android:layout_gravity="fill"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="1dp"
                />
            <SurfaceView
                android:id="@+id/surfaceviewSecondNineteen3"
                android:layout_gravity="fill"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="1dp"
                />
        </TableRow>

        <TableRow
            android:layout_weight="1"
            android:layout_height="0dp"
            android:gravity="center">

            <SurfaceView
                android:id="@+id/surfaceviewSecondNineteen4"
                android:layout_gravity="fill"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="1dp"
                />
            <SurfaceView
                android:id="@+id/surfaceviewSecondNineteen5"
                android:layout_gravity="fill"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="1dp"
                />
            <SurfaceView
                android:id="@+id/surfaceviewSecondNineteen6"
                android:layout_gravity="fill"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="1dp"
                />
        </TableRow>
        <TableRow
            android:layout_weight="1"
            android:layout_height="0dp"
            android:gravity="center">

            <SurfaceView
                android:id="@+id/surfaceviewSecondNineteen7"
                android:layout_gravity="fill"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="1dp"
                />
            <SurfaceView
                android:id="@+id/surfaceviewSecondNineteen8"
                android:layout_gravity="fill"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="1dp"
                />
            <SurfaceView
                android:id="@+id/surfaceviewSecondNineteen9"
                android:layout_gravity="fill"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="1dp"
                />
        </TableRow>
    </TableLayout>
</android.support.constraint.ConstraintLayout>